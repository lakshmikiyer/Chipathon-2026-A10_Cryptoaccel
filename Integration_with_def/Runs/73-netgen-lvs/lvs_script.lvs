lvs "$circuit1 A10_A" "$circuit2 A10_A" /usr/local/lib/python3.12/dist-packages/librelane/scripts/netgen/setup.tcl /foss/designs/ascon_run_deffile/runs/run11/73-netgen-lvs/reports/lvs.netgen.rpt -blackbox -json
